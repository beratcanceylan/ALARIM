{
  "expo": {
    "name": "ALARIM",
    "slug": "alarim",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "userInterfaceStyle": "automatic",
    "scheme": "alarim",
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.beratcanceylan.alarim",
      "permissions": [
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.beratcanceylan.alarim"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "defaultChannel": "alarms"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ALARIM alarm görsellerini seçebilmek için fotoğraflarına erişmek istiyor.",
          "cameraPermission": "ALARIM alarm görseli çekebilmek için kameranı kullanmak istiyor."
        }
      ],
      "expo-document-picker",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false
        }
      ],
      "expo-sqlite",
      "expo-asset",
      "expo-image",
      "expo-font"
    ]
  }
}
